# CustodyHub — copy to .env and fill in real values.
# .env is gitignored; .env.example is committed as the canonical reference.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma (via @prisma/adapter-pg).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/custodyhub?schema=public"

# ---------------------------------------------------------------------------
# Sessions (REQUIRED in production)
# ---------------------------------------------------------------------------
# 32+ random bytes used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Email (OPTIONAL — leave blank to log emails to console in dev)
# ---------------------------------------------------------------------------
# SMTP transport. Used for password resets, warranty alerts, etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CustodyHub <noreply@example.com>"

# Public base URL used inside email links (e.g. password reset).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage (OPTIONAL)
# ---------------------------------------------------------------------------
# Local directory for uploaded attachments (invoices, photos, etc.).
# Defaults to ./uploads if unset.
UPLOAD_DIR=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE_USE
  AVAILABLE
  SERVICEABLE
  DAMAGED
  UNDER_SERVICE
}

enum ReturnReason {
  RESIGNED
  DAMAGED
  NOT_NEEDED
  OTHER
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

model User {
  id         String   @id @default(cuid())
  name       String   @unique
  email      String?  @unique
  password   String
  isActive   Boolean  @default(true)
  role       UserRole @default(USER)

  createdBy  String?
  createdAt  DateTime @default(now())
  updatedBy  String?
  updatedAt  DateTime @updatedAt

  lastLogin  DateTime?

  sessions   Session[]

  @@index([name])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model FailedLogin {
  id         String   @id @default(cuid())
  username   String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Product {
  id            String        @id @default(cuid())
  product       String
  brand         String
  snNumber      String?       @unique
  sku           String        @unique
  specification String?
  quantity      Int           @default(1)
  orderedDate   DateTime?
  cost          Decimal?
  warrantyPeriodId String?
  warrantyPeriod WarrantyPeriodModel? @relation(fields: [warrantyPeriodId], references: [id])
  warrantyExpire DateTime?

  categoryId    String
  category      Category      @relation(fields: [categoryId], references: [id])
  assetTypeId   String
  assetType     AssetType     @relation(fields: [assetTypeId], references: [id])

  locationId    String?
  location      Location?     @relation(fields: [locationId], references: [id])
  departmentId  String?
  department    DepartmentModel? @relation(fields: [departmentId], references: [id])

  createdBy     String?
  createdAt     DateTime      @default(now())
  updatedBy     String?
  updatedAt     DateTime      @updatedAt

  assignedTo    String?
  status        ProductStatus @default(AVAILABLE)

  staffAssignments StaffInventory[]
  services        ProductService[]
  attachments     Attachment[]
}

model SkuSequence {
  prefix    String   @id
  next      Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Location {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String    @unique
  address    String?
  isActive   Boolean   @default(true)
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  products   Product[]
}

model Attachment {
  id            String          @id @default(cuid())
  filename      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  productId     String?
  product       Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       ProductService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  uploadedBy    String?
  uploadedAt    DateTime        @default(now())

  @@index([productId])
  @@index([serviceId])
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  prefix     String?
  isActive   Boolean   @default(true)
  createdBy  String?
  updatedBy  String?
  assetTypeId String?
  assetType AssetType? @relation(fields: [assetTypeId], references: [id])
  products Product[]
}

model AssetType {
  id         String    @id @default(cuid())
  name       String    @unique
  isActive   Boolean   @default(true)
  createdBy  String?
  updatedBy  String?
  products Product[]
  categories Category[]
}

model Staff {
  id         String           @id @default(cuid())
  name       String
  departmentId String
  isActive   Boolean          @default(true)
  createdBy  String?
  updatedBy  String?
  department DepartmentModel @relation(fields: [departmentId], references: [id])
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  inventoryUsing StaffInventory[]
}

model DepartmentModel {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String   @unique
  isActive   Boolean  @default(true)
  createdBy  String?
  updatedBy  String?
  staffs     Staff[]
  products   Product[]
}

model WarrantyPeriodModel {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String    @unique
  months     Int
  isActive   Boolean   @default(true)
  createdBy  String?
  updatedBy  String?
  products Product[]
}

model StaffInventory {
  id              String   @id @default(cuid())
  staffId         String
  productId       String
  quantity        Int      @default(1)
  startDate       DateTime
  returnDate      DateTime?
  returnReason    ReturnReason?
  returnReasonNote String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedBy       String?
  updatedAt       DateTime @updatedAt

  staff   Staff   @relation(fields: [staffId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([staffId])
  @@index([productId])
}

model ProductService {
  id                 String    @id @default(cuid())
  productId           String
  product            Product   @relation(fields: [productId], references: [id])

  repairable          Boolean
  notes               String?
  sentToService       Boolean
  vendorName          String?
  expectedReturnDate  DateTime?

  // Only relevant when sentToService=true:
  // null = still in service, true = serviced, false = service failed.
  serviced            Boolean?
  serviceDate         DateTime?
  serviceCost         Decimal?
  serviceMessage      String?
  serviceFailureReason String?

  createdBy           String?
  createdAt           DateTime  @default(now())
  updatedBy           String?
  updatedAt           DateTime  @updatedAt

  attachments         Attachment[]

  @@index([productId])
  @@index([sentToService])
  @@index([serviced])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  actorUserId String
  actorName   String
  summary     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
